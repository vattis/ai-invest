# Copy to .env.worker.local. Never deploy this file to Vercel.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_KEY
# Node entry point installed by npm install -g @openai/codex (absolute path).
CODEX_JS_PATH=C:/path/to/node_modules/@openai/codex/bin/codex.js
# Alternative on Unix or native Windows exe: CODEX_BIN=codex
WORKER_ID=home-pc
WORKER_POLL_SECONDS=10
CODEX_TIMEOUT_SECONDS=120
# Optional: an OS-isolated account/container working root for agent tasks.
WORKER_ROOT=.runtime
KIS_APP_KEY=YOUR_KIS_APP_KEY
KIS_APP_SECRET=YOUR_KIS_APP_SECRET
ALPACA_KEY_ID=YOUR_ALPACA_MARKET_DATA_KEY
ALPACA_SECRET_KEY=YOUR_ALPACA_MARKET_DATA_SECRET
# Simulator assumptions; per-side fee and slippage fractions.
PAPER_FEE_RATE=0.0005
PAPER_SLIPPAGE=0.0005
MAX_ROUNDS_PER_DAY=20
MARKET_POLL_SECONDS=60
